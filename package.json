{
  "name": "culver-city-surgical-dashboard-docupipe",
  "version": "1.0.0",
  "private": true,
  "description": "DocuPipe and Stedi-enabled clone of the Culver City Surgical dashboard.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check lib/docupipe.js && node --check \"functions/[[path]].js\"",
    "cf:dev": "npx wrangler pages dev . --compatibility-date=2026-06-13",
    "cf:dev:mock": "npx wrangler pages dev . --compatibility-date=2026-06-13 --binding APP_MODE=mock",
    "cf:deploy": "npx wrangler pages deploy . --project-name=culver-city-surgical-dashboard"
  },
  "engines": {
    "node": ">=20"
  }
}
