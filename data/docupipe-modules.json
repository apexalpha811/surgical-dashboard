    "dashboardTarget": "providers",
    "stediEndpoint": "/providers",
    "guidelines": "Extract provider enrollment data, provider name, NPI, taxonomy, tax ID, specialty, payer, enrollment transaction type, signature dates, and requested supporting documents.",
    "jsonSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "Extract provider and enrollment details for Stedi provider and enrollment workflows.",
      "type": "object",
      "properties": {
        "documentType": {
          "type": "string",
          "description": "Document category.",
          "enum": [
            "providerEnrollment"
          ]
        },
        "provider": {
          "type": "object",
          "description": "Provider details.",
          "properties": {
            "name": {
              "type": "string",
              "description": "Provider full name or organization name."
            },
            "firstName": {
              "type": "string",
              "description": "Provider first name."
            },
            "lastName": {
              "type": "string",
              "description": "Provider last name."
            },
            "credential": {
              "type": "string",
              "description": "Credential such as MD, DO, NP, or PA."
            },
            "specialty": {
              "type": "string",
              "description": "Provider specialty."
            },
            "npi": {
              "type": "string",
              "description": "Provider NPI."
            },
            "taxonomyCode": {
              "type": "string",
              "description": "Taxonomy code."
            },
            "taxId": {
              "type": "string",
              "description": "Tax ID or EIN."
            }
          }
        },
        "enrollment": {
          "type": "object",
          "description": "Enrollment details.",
          "properties": {
            "payerName": {
              "type": "string",
              "description": "Payer name."
            },
            "transactionType": {
              "type": "string",
              "description": "Enrollment transaction type such as 837P claims, 837I claims, 835 ERA, or 270 eligibility."
            },
            "submittedDate": {
              "type": "string",
              "format": "date",
              "description": "Submitted or signature date in YYYY-MM-DD format."
            },
            "requestedDocuments": {
              "type": "array",
              "description": "Supporting documents requested by payer.",
              "items": {
                "type": "string",
                "description": "Document name."
              }
            }
          }
        }
      }
    },
    "fieldMappings": [
      {
        "source": "provider.name",
        "dashboard": "providers.name",
        "stedi": "providers.name"
      },
      {
        "source": "provider.npi",
        "dashboard": "providers.npi",
        "stedi": "providers.npi"
      },
      {
        "source": "provider.taxonomyCode",
        "dashboard": "providers.tax",
        "stedi": "providers.taxonomyCode"
      },
      {
        "source": "enrollment.payerName",
        "dashboard": "enrollments.payer",
        "stedi": "enrollments.payer"
      }
    ]
  }
]
